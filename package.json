{
  "name": "@arafat2020/kurenai",
  "version": "2.2.0-beta.0",
  "description": "A DSL compiler that converts human-readable video pipeline scripts into FFmpeg commands",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "require": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "tsx src/main.ts",
    "test": "vitest",
    "test:node": "vitest --project node",
    "test:browser": "vitest --project browser",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "ffmpeg",
    "dsl",
    "compiler",
    "video",
    "pipeline"
  ],
  "author": "Arafat Mannan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arafat2020/kurenai.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/ui": "^4.1.8",
    "mp4-muxer": "^5.2.2",
    "playwright": "^1.62.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "g": "^2.0.1",
    "mediabunny": "^1.52.3"
  },
  "bin": {
    "kurenai": "dist/main.js"
  }
}